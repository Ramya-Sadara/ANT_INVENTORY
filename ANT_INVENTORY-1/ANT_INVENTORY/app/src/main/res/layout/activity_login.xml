<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANT INVENTORY"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in to continue"
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingBottom="32dp" />

        <!-- Tab switcher -->
        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/tab_container"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tabSignIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Sign In"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/tab_selected"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tabRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Register"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/tab_unselected"
                android:textColor="#1565C0" />

        </LinearLayout>

        <!-- Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Sign In layout -->
        <LinearLayout
            android:id="@+id/layoutSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSignInUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:padding="14dp" />

            <EditText
                android:id="@+id/etSignInPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:layout_marginBottom="16dp"
                android:background="@drawable/field_background"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SIGN IN"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot password? Reset it"
                android:textColor="#1565C0"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Register layout -->
        <LinearLayout
            android:id="@+id/layoutRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etRegUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Choose a username"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:padding="14dp" />

            <EditText
                android:id="@+id/etRegPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Choose a password (min 4 characters)"
                android:inputType="textPassword"
                android:singleLine="true"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:padding="14dp" />

            <EditText
                android:id="@+id/etRegConfirmPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:layout_marginBottom="16dp"
                android:background="@drawable/field_background"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="CREATE ACCOUNT"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
