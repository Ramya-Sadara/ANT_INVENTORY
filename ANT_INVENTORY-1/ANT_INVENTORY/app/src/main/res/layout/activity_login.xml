<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANT INVENTORY"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:gravity="center"
            android:paddingTop="56dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your PIN to continue"
            android:textSize="15sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingBottom="40dp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Set PIN (first launch) -->
        <LinearLayout
            android:id="@+id/layoutSetPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etNewPin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Enter new PIN (min 4 digits)"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:gravity="center"
                android:textSize="24sp"
                android:letterSpacing="0.3"
                android:layout_marginBottom="14dp"
                android:background="@drawable/field_background"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etConfirmPin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Confirm PIN"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:gravity="center"
                android:textSize="24sp"
                android:letterSpacing="0.3"
                android:layout_marginBottom="24dp"
                android:background="@drawable/field_background"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSetPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SET PIN &amp; CONTINUE"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />

        </LinearLayout>

        <!-- Enter PIN (returning users) -->
        <LinearLayout
            android:id="@+id/layoutEnterPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Enter PIN"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:gravity="center"
                android:textSize="28sp"
                android:letterSpacing="0.4"
                android:layout_marginBottom="24dp"
                android:background="@drawable/field_background"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="UNLOCK"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvForgotPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot PIN? Reset it"
                android:textColor="#1565C0"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
