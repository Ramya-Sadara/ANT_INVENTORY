<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with Logout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANT INVENTORY"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:gravity="center" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Logout"
                android:textSize="12sp"
                android:textColor="#C62828"
                android:backgroundTint="#FFEBEE" />

        </LinearLayout>

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Entry"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:paddingBottom="12dp" />

            <!-- Order No with scan button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etOrder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Order No / Barcode"
                    android:inputType="text"
                    android:singleLine="true"
                    android:background="@drawable/field_background"
                    android:padding="12dp" />

                <ImageButton
                    android:id="@+id/btnScanOrder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/scan_button_background"
                    android:tint="#FFFFFF"
                    android:contentDescription="Scan Order barcode" />

            </LinearLayout>

            <!-- Part No with scan button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etPart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Part No / Barcode"
                    android:inputType="text"
                    android:singleLine="true"
                    android:background="@drawable/field_background"
                    android:padding="12dp" />

                <ImageButton
                    android:id="@+id/btnScanPart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/scan_button_background"
                    android:tint="#FFFFFF"
                    android:contentDescription="Scan Part barcode" />

            </LinearLayout>

            <EditText
                android:id="@+id/etQty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Physical Quantity"
                android:inputType="number"
                android:singleLine="true"
                android:layout_marginBottom="10dp"
                android:background="@drawable/field_background"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Remarks (optional)"
                android:inputType="text|textCapSentences"
                android:singleLine="true"
                android:layout_marginBottom="10dp"
                android:background="@drawable/field_background"
                android:padding="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="13sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/field_background"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SAVE / NEXT ITEM"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExport"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="EXPORT CSV"
                    android:textColor="#1565C0"
                    android:backgroundTint="#E3F2FD"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnClearAll"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="CLEAR ALL"
                    android:textColor="#C62828"
                    android:backgroundTint="#FFEBEE"
                    android:layout_marginStart="6dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Saved Entries -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saved Entries"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

                <TextView
                    android:id="@+id/tvEntryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 entries"
                    android:textSize="13sp"
                    android:textColor="#777777" />

            </LinearLayout>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Search by Order, Part, Location or Remarks…"
                android:inputType="text"
                android:singleLine="true"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:padding="10dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No entries yet. Fill the form above and tap SAVE."
                android:textColor="#999999"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
