<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Guide only: any label barcode anywhere on the screen is read. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/scan_frame" />

    <TextView
        android:id="@+id/tvScanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="260dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Point at the label barcode. Tap the screen to focus."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnUseAnyway"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="190dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:backgroundTint="#1565C0"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/seekZoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="115dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:max="100" />

    <Button
        android:id="@+id/btnTorch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="44dp"
        android:backgroundTint="#37474F"
        android:text="Light OFF"
        android:textColor="#FFFFFF" />

    <ImageButton
        android:id="@+id/btnCancelScan"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/circle_button"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Cancel scan"
        android:tint="#FFFFFF" />

</FrameLayout>
